# =============================================================================
# FungsionalPro — Docker Production Environment Template
# =============================================================================
# Copy this file to .env and fill in the values for your deployment.
# Variables marked [REQUIRED] must be set. Others have sensible defaults.
# =============================================================================

# ── Application ────────────────────────────────────────────────────────────────

APP_NAME=FungsionalPro                    # [REQUIRED] Application name
APP_ENV=production                       # [REQUIRED] production|staging|local
APP_KEY=                                 # [REQUIRED] Generate with: php artisan key:generate
APP_DEBUG=false                         # [REQUIRED] Always false in production
APP_URL=https://your-domain.com          # [REQUIRED] Full URL with scheme
APP_TIMEZONE=Asia/Jakarta               # Default: UTC
TRUSTED_PROXY=                             # Leave empty only if no reverse proxy. Prefer LB CIDRs; avoid '*' unless edge proxy is fully trusted.
APP_LOCALE=id                           # Default: en
APP_FALLBACK_LOCALE=id                  # Default: en
APP_FAKER_LOCALE=id_ID                  # Default: en_US

# ── Database ───────────────────────────────────────────────────────────────────

DB_CONNECTION=mysql                       # [REQUIRED] mysql|pgsql|sqlite
DB_HOST=db                              # [REQUIRED] Database hostname (use service name in compose)
DB_PORT=3306                             # [REQUIRED] 3306 for MySQL, 5432 for PostgreSQL
DB_DATABASE=fungsionalpro               # [REQUIRED] Database name
DB_USERNAME=fungsionalpro                # [REQUIRED] Database user
DB_PASSWORD=                            # [REQUIRED] Database password

# ── Cache & Session & Queue ──────────────────────────────────────────────────
# These are hardcoded to redis in docker-compose.yml, but listed here
# for documentation. Only change if you're NOT using the redis container.

SESSION_DRIVER=redis                    # Hardcoded in docker-compose → redis
SESSION_LIFETIME=120                    # Minutes
SESSION_ENCRYPT=false                   # Default: false
SESSION_SECURE_COOKIE=true               # Default: true (recommended)
SESSION_SAME_SITE=lax                    # Default: lax
SESSION_PATH=/
SESSION_DOMAIN=                         # Leave empty unless using subdomains
SESSION_CONNECTION=redis                 # Hardcoded in docker-compose → redis

QUEUE_CONNECTION=redis                  # Hardcoded in docker-compose → redis
CACHE_STORE=redis                       # Hardcoded in docker-compose → redis
CACHE_PREFIX=fungsionalpro_cache_        # Prefix for cache keys

BCRYPT_ROUNDS=12                        # [REQUIRED] Default: 10

# ── Redis ──────────────────────────────────────────────────────────────────────
# Host/port are hardcoded in docker-compose.yml to point to the redis service.
# Only change if using an external Redis instance.

REDIS_CLIENT=phpredis                    # Default: phpredis
REDIS_HOST=redis                         # Docker service name (hardcoded in compose)
REDIS_PASSWORD=                          # [REQUIRED] Must match Redis requirepass in docker-compose
REDIS_PORT=6379                          # Hardcoded in compose
REDIS_DB=0                               # Default: 0
# Redis container: 512mb maxmemory + volatile-lru (see docker-compose.yml)

# ── Log ────────────────────────────────────────────────────────────────────────

LOG_CHANNEL=stack                        # [REQUIRED] stack|daily|single|slack
LOG_LEVEL=error                          # Default: debug (use error/warning in production)
LOG_STACK=daily                          # Channels in the stack
LOG_DEPRECATIONS_CHANNEL=null            # Default: null

# ── Mail ────────────────────────────────────────────────────────────────────────

MAIL_MAILER=smtp                         # [REQUIRED] smtp|sendmail|mailgun|ses|log
MAIL_HOST=smtp.example.com              # [REQUIRED] SMTP server
MAIL_PORT=587                            # [REQUIRED] 587 (TLS) or 465 (SSL)
MAIL_USERNAME=                           # [REQUIRED] SMTP username
MAIL_PASSWORD=                           # [REQUIRED] SMTP password
MAIL_ENCRYPTION=tls                      # Default: tls
MAIL_FROM_ADDRESS=noreply@example.com    # [REQUIRED] From address
MAIL_FROM_NAME="FungsionalPro"           # [REQUIRED] From name

# ── Filesystem / S3 / MinIO ─────────────────────────────────────────────────

FILESYSTEM_DISK=s3                       # [REQUIRED] s3|public|local
FILAMENT_FILESYSTEM_DISK=s3              # [REQUIRED] s3|public|local

AWS_ENDPOINT=https://s3.region.amazonaws.com  # [REQUIRED] S3 endpoint
AWS_URL=                                # Optional: custom URL for S3 objects
AWS_ACCESS_KEY_ID=                       # [REQUIRED] S3 access key
AWS_SECRET_ACCESS_KEY=                   # [REQUIRED] S3 secret key
AWS_DEFAULT_REGION=ap-southeast-1       # Default: us-east-1
AWS_BUCKET=fungsionalpro                 # [REQUIRED] S3 bucket name
AWS_USE_PATH_STYLE_ENDPOINT=false        # true for MinIO, false for AWS S3

# ── Broadcast ──────────────────────────────────────────────────────────────────

BROADCAST_CONNECTION=log                 # log|redis|pusher|ably

# ── Octane / Container Runtime ───────────────────────────────────────────────

OCTANE_SERVER=swoole                     # [REQUIRED] swoole|frankenphp|roadrunner
OCTANE_WORKERS=2                         # Swoole workers — keep low on 1G app container
OCTANE_MAX_REQUESTS=500                  # Recycle workers to contain memory leaks
WORKER_NUMPROCS=2                        # queue:work processes — 8 OOMs a 512M worker container
CONTAINER_MODE=http                      # http|horizon|scheduler|worker
RUNNING_MIGRATIONS_AND_SEEDERS=false     # Set true on first deploy

# ── Vite (Frontend) ──────────────────────────────────────────────────────────

VITE_APP_NAME=FungsionalPro              # Frontend app name