# =============================================================================
# FungsionalPro — Docker Production Environment Template
# =============================================================================
# Copy this file to .env and fill in the values for your deployment.
#
# IMPORTANT: Docker Compose --env-file does NOT support inline comments.
# Never put "# comment" on the same line as KEY=value — it becomes part of
# the value (e.g. SESSION_DOMAIN with spaces → Swoole cookie crash).
# Put comments on their own lines only.
# =============================================================================

# ── Application ────────────────────────────────────────────────────────────────

# [REQUIRED]
APP_NAME=FungsionalPro
# [REQUIRED] production|staging|local
APP_ENV=production
# [REQUIRED] Generate with: php artisan key:generate --show
APP_KEY=
# [REQUIRED] Always false in production
APP_DEBUG=false
# [REQUIRED] Full URL with scheme
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Jakarta
# [REQUIRED behind HTTPS reverse proxy] Empty = Laravel sees HTTP → Livewire/Filament 419.
# Prefer LB/proxy CIDRs. Use * only when the edge proxy is fully trusted.
# Loaded via config/app.php (config:cache-safe). Do not rely on env() in bootstrap.
TRUSTED_PROXY=*
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
# cache|file — use cache so app+worker share status
APP_MAINTENANCE_DRIVER=cache
# Cache store name when driver=cache (must exist in config/cache.php)
APP_MAINTENANCE_STORE=redis

# ── Database ───────────────────────────────────────────────────────────────────

# [REQUIRED] mysql|pgsql|sqlite
DB_CONNECTION=mysql
# [REQUIRED] Database hostname (use service name in compose, or host IP)
DB_HOST=db
# [REQUIRED] 3306 for MySQL, 5432 for PostgreSQL
DB_PORT=3306
# [REQUIRED]
DB_DATABASE=fungsionalpro
# [REQUIRED]
DB_USERNAME=fungsionalpro
# [REQUIRED]
DB_PASSWORD=

# ── Cache & Session & Queue ──────────────────────────────────────────────────
# SESSION_DRIVER / CACHE_STORE / QUEUE_CONNECTION are also set in docker-compose.yml.
# SESSION_CONNECTION must be a Redis connection key in config/database.php:
# default | cache | queue — NOT the literal word "redis".

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
# Leave empty for host-only cookie. Set e.g. .example.com for subdomains (no spaces).
SESSION_DOMAIN=
SESSION_CONNECTION=default

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=fungsionalpro_cache_

# [REQUIRED]
BCRYPT_ROUNDS=12

# ── Redis ──────────────────────────────────────────────────────────────────────
# Host/port are hardcoded in docker-compose.yml to the redis service.

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# [REQUIRED] Must match Redis --requirepass in docker-compose
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# ── Log ────────────────────────────────────────────────────────────────────────

# [REQUIRED] stack|daily|single|slack
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null

# ── Mail ────────────────────────────────────────────────────────────────────────

# [REQUIRED] smtp|sendmail|mailgun|ses|log
MAIL_MAILER=smtp
# [REQUIRED]
MAIL_HOST=smtp.example.com
# [REQUIRED] 587 (TLS) or 465 (SSL)
MAIL_PORT=587
# [REQUIRED]
MAIL_USERNAME=
# [REQUIRED]
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# [REQUIRED]
MAIL_FROM_ADDRESS=noreply@example.com
# [REQUIRED]
MAIL_FROM_NAME=FungsionalPro

# ── Filesystem / S3 / MinIO ─────────────────────────────────────────────────

# [REQUIRED] s3|public|local
FILESYSTEM_DISK=s3
# [REQUIRED] s3|public|local
FILAMENT_FILESYSTEM_DISK=s3

# [REQUIRED]
AWS_ENDPOINT=https://s3.region.amazonaws.com
# Optional: custom URL for S3 objects
AWS_URL=
# [REQUIRED]
AWS_ACCESS_KEY_ID=
# [REQUIRED]
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
# [REQUIRED]
AWS_BUCKET=fungsionalpro
# true for MinIO / path-style, false for AWS virtual-hosted
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Broadcast ──────────────────────────────────────────────────────────────────

# log|redis|pusher|ably
BROADCAST_CONNECTION=log

# ── Octane / Container Runtime ───────────────────────────────────────────────

# [REQUIRED] swoole|frankenphp|roadrunner
OCTANE_SERVER=swoole
# true when TLS terminates at the reverse proxy (prevents Livewire "page has expired")
OCTANE_HTTPS=true
# Keep low on a 1G app container
OCTANE_WORKERS=2
OCTANE_MAX_REQUESTS=500
# queue:work processes — too many OOMs a 512M worker container
WORKER_NUMPROCS=2
# http|horizon|scheduler|worker (compose overrides per service)
CONTAINER_MODE=http
# Set true only on first deploy, then false
RUNNING_MIGRATIONS_AND_SEEDERS=false

# ── Vite (Frontend) ──────────────────────────────────────────────────────────

VITE_APP_NAME=FungsionalPro
